generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum VideoStatus { UPLOADING UPLOADED ANALYZING PARTIAL READY FAILED }
enum JobStatus { QUEUED RUNNING PARTIAL COMPLETED FAILED CANCELLED }
enum ChunkStatus { PENDING PROCESSING COMPLETED FAILED }
enum AudioStatus { PENDING GENERATING READY FAILED DISABLED }
model GoogleConnection { id String @id encryptedTokens String email String? rootFolderId String? audioFolderId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Video { id String @id @default(uuid()) title String originalName String mimeType String sizeBytes BigInt durationMs Int? driveFileId String? @unique driveWebViewUrl String? status VideoStatus @default(UPLOADING) failureReason String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt jobs AnalysisJob[] chunks VideoChunk[] segments CommentarySegment[] @@index([createdAt]) }
model AnalysisJob { id String @id @default(uuid()) videoId String video Video @relation(fields:[videoId],references:[id],onDelete:Cascade) status JobStatus @default(QUEUED) model String fps Float chunkSeconds Int overlapSeconds Float generateAudio Boolean @default(true) progress Int @default(0) stage String @default("queued") errorMessage String? startedAt DateTime? finishedAt DateTime? createdAt DateTime @default(now()) chunks VideoChunk[] segments CommentarySegment[] @@index([videoId,createdAt]) }
model VideoChunk { id String @id @default(uuid()) analysisJobId String job AnalysisJob @relation(fields:[analysisJobId],references:[id],onDelete:Cascade) videoId String video Video @relation(fields:[videoId],references:[id],onDelete:Cascade) chunkIndex Int startMs Int endMs Int status ChunkStatus @default(PENDING) errorMessage String? createdAt DateTime @default(now()) @@unique([analysisJobId,chunkIndex]) }
model CommentarySegment { id String @id @default(uuid()) videoId String video Video @relation(fields:[videoId],references:[id],onDelete:Cascade) analysisJobId String job AnalysisJob @relation(fields:[analysisJobId],references:[id],onDelete:Cascade) chunkIndex Int startMs Int endMs Int eventType String observation String commentaryText String emotion String confidence Float sourceHash String audioStatus AudioStatus @default(PENDING) createdAt DateTime @default(now()) audio AudioAsset? @@unique([videoId,sourceHash]) @@index([videoId,startMs]) }
model AudioAsset { id String @id @default(uuid()) segmentId String @unique segment CommentarySegment @relation(fields:[segmentId],references:[id],onDelete:Cascade) driveFileId String @unique fileName String mimeType String sizeBytes BigInt durationMs Int? createdAt DateTime @default(now()) }